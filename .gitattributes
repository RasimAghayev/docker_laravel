* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Linguist overrides
*.blade.php linguist-language=PHP
*.md linguist-documentation=true
Command.txt linguist-documentation=true
docker-compose*.yml linguist-language=YAML
*.dockerfile linguist-language=Dockerfile
nginx/* linguist-language=NGINX
apache/* linguist-language=ApacheConf

# Lockfiles - treat as generated
*lock.json linguist-generated=true
composer.lock linguist-generated=true
package-lock.json linguist-generated=true